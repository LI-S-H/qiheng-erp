<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.qiheng</groupId>
        <artifactId>erp-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>erp-ai</artifactId>
    <name>erp-ai</name>

    <dependencies>
        <dependency>
            <groupId>com.qiheng</groupId>
            <artifactId>erp-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qiheng</groupId>
            <artifactId>erp-security</artifactId>
        </dependency>

        <!-- Spring AI OpenAI 兼容协议(用于 DeepSeek / 后续豆包等) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>

        <!-- Graph 编排和独立摘要 Hook，沿用当前已验证的框架版本。 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
        </dependency>

        <!--
          AI 取数专用连接池：只用核心包，不引 druid-spring-boot-3-starter。
          池由 ReadOnlySqlExecutor 自行创建，不注册为容器里的 DataSource bean，
          主数据源继续由 Spring Boot 自动装配，两边互不干扰。
        -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 真库集成测试连真实 MySQL；生产运行不需要驱动，由 erp-admin 提供。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
