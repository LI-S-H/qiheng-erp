<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.qiheng</groupId>
        <artifactId>erp-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>erp-purchase</artifactId>
    <name>erp-purchase</name>

    <dependencies>
        <dependency>
            <groupId>com.qiheng</groupId>
            <artifactId>erp-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qiheng</groupId>
            <artifactId>erp-product</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qiheng</groupId>
            <artifactId>erp-warehouse</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qiheng</groupId>
            <artifactId>erp-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qiheng</groupId>
            <artifactId>erp-return</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Knife / OpenAPI3，Controller 里用 @Tag、@Operation 等 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- Sa-Token 核心，Controller 里用 StpUtil.checkPermission(...) -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-core</artifactId>
            <version>1.45.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 真实采购评分事实的只读 MySQL 集成测试，不进入生产依赖。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- RocketMQ 评分重算 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>${rocketmq-spring.version}</version>
        </dependency>
    </dependencies>
</project>
