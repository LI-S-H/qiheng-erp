<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiheng.erp.purchase.mapper.SupplierMapper">

    <!-- 逻辑删除（带乐观锁 version 校验） -->
    <update id="deleteByIdWithVersion">
        UPDATE supplier
        SET deleted = 1
        WHERE id = #{id}
          AND version = #{version}
          AND deleted = 0
    </update>

</mapper>
