<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiheng.erp.purchase.mapper.SupplierMapper">

    <!-- 逻辑删除（带乐观锁 version 校验） -->
    <update id="deleteByIdWithVersion">
        UPDATE supplier
        SET deleted = 1
        WHERE id = #{id}
          AND version = #{version}
          AND deleted = 0
    </update>

    <!--
        累加 supplier.score_basis_amount(分)。
        用 SQL 表达式在数据库层做加法,避免读改写竞争;
        数据库行锁保障并发安全。
        用于 PurchaseInboundWritebackPort 入库确认后累加评分样本金额。
    -->
    <update id="incrementScoreBasisAmount">
        UPDATE supplier
        SET score_basis_amount = score_basis_amount + #{delta}
        WHERE id = #{supplierId}
          AND deleted = 0
    </update>

</mapper>
