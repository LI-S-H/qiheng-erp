<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiheng.erp.purchase.mapper.SupplierProductMapper">

    <!-- 逻辑删除供货产品（带乐观锁 version 校验） -->
    <update id="deleteByIdWithVersion">
        UPDATE supplier_product
        SET deleted = 1
        WHERE id = #{id}
          AND version = #{version}
          AND deleted = 0
    </update>

    <!--
        累加 supplier_product.score_basis_amount(分)。
        SQL 表达式在数据库层做加法,避免读改写竞争;
        数据库行锁保障并发安全。
        用于 PurchaseInboundWritebackPort 入库确认后按 SP 维度累加评分样本金额。
    -->
    <update id="incrementScoreBasisAmount">
        UPDATE supplier_product
        SET score_basis_amount = score_basis_amount + #{delta}
        WHERE id = #{supplierProductId}
          AND deleted = 0
    </update>

</mapper>
